{
  "compilerOptions": {
    "allowJs": true,
    "lib": [
      "deno.window",
      "esnext",
      "dom",
      "dom.iterable"
    ],
    "strict": false
  },
  "lint": {
    "include": [
      "src/"
    ],
    "exclude": [
      "src/testdata/",
      "data/fixtures/**/*.ts"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "include": [
        "ban-untagged-todo"
      ],
      "exclude": [
        "no-unused-vars"
      ]
    }
  },
  "fmt": {
    "useTabs": true,
    "lineWidth": 80,
    "indentWidth": 4,
    "semiColons": false,
    "singleQuote": true,
    "proseWrap": "preserve",
    "include": [
      "src/"
    ],
    "exclude": [
      "src/testdata/",
      "data/fixtures/**/*.ts"
    ]
  },
  "tasks": {
    "start": "deno run --unstable --allow-env --allow-net --allow-read --allow-write main.ts"
  },
  "imports": {
    "hono": "https://deno.land/x/hono@v3.4.1/mod.ts",
    "mariadb": "https://deno.land/x/mysql/mod.ts",
    "openai": "https://deno.land/x/openai/mod.ts",
    "cors": "https://deno.land/x/hono@v3.4.1/middleware.ts",
    "zod": "https://deno.land/x/zod/mod.ts",
    "cheerio": "https://esm.sh/cheerio@1.0.0-rc.12",
    "supabase": "https://esm.sh/@supabase/supabase-js",
    "moment": "https://deno.land/x/momentjs@2.29.1-deno/mod.ts",
    "houston": "https://deno.land/x/houston@1.0.0/mod.ts"
}
}